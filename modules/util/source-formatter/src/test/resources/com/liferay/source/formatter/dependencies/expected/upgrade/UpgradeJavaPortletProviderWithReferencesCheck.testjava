package com.liferay.source.formatter.dependencies.upgrade;

import com.liferay.portal.kernel.portlet.PortletProvider;

import com.liferay.osgi.service.tracker.collections.map.ServiceTrackerMap;

@Component(service = Foo.class)
public class UpgradeJavaPortletProviderWithReferencesCheck {

	public String getPortletName() {
		return _viewPortletProvider.getPortletName();
	}

	private ServiceTrackerMap<String, PortletProvider> _serviceTrackerMap;

	@Reference
	private PortletProvider _viewPortletProvider;

}