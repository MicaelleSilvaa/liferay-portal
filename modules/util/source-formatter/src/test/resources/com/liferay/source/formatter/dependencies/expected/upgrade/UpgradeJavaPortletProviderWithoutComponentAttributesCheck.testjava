package com.liferay.source.formatter.dependencies.upgrade;

import com.liferay.portal.kernel.portlet.PortletProvider;

import com.liferay.portal.kernel.portlet.BasePortletProvider;

@Component(service = PortletProvider.class)
public class UpgradeJavaPortletProviderWithoutComponentAttributesCheck extends BasePortletProvider {

	@Override
	public String getPortletName() {
		return TestPortletKeys.TEST;
	}

	@Override
	public Action[] getSupportedActions() {
		return _supportedActions;
	}

	private final Action[] _supportedActions = {Action.EDIT};

}