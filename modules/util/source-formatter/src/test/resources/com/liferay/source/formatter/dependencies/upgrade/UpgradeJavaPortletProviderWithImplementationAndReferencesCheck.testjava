package com.liferay.source.formatter.dependencies.upgrade;

import com.liferay.portal.kernel.portlet.BasePortletProvider;
import com.liferay.portal.kernel.portlet.EditPortletProvider;
import com.liferay.portal.kernel.portlet.ViewPortletProvider;

@Component(service = ViewPortletProvider.class)
public class UpgradeJavaPortletProviderWithImplementationAndReferencesCheck
	extends BasePortletProvider implements ViewPortletProvider {

	@Override
	public String getPortletName() {
		return _editPortletProvider.getPortletName();
	}

	@Reference
	private EditPortletProvider _editPortletProvider;

}