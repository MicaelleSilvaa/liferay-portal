package com.liferay.source.formatter.dependencies.upgrade;

import com.liferay.portal.kernel.portlet.PortletProvider;

import com.liferay.portal.kernel.language.Language;
import com.liferay.portal.kernel.portlet.BasePortletProvider;
import com.liferay.portal.kernel.service.UserLocalService;

@Component(
	property = "model.class.name=" + TestConstants.CLASS_NAME_TEST_ENTRY,
	service = {Foo.class, PortletProvider.class}
)
public class UpgradeJavaPortletProviderWithPrivateMembersCheck extends BasePortletProvider implements Foo {

	@Override
	public String getPortletName() {
		return _getPortletName();
	}

	@Override
	public Action[] getSupportedActions() {
		return _supportedActions;
	}

	@Override
	public boolean isVisible() {
		return true;
	}

	private String _getPortletName() {
		return _language.get(LocaleUtil.getDefault(), TestPortletKeys.TEST);
	}

	@Reference
	private Language _language;

	private final Action[] _supportedActions = {Action.EDIT, Action.VIEW};

	@Reference
	private UserLocalService _userLocalService;

}